 properties from built-in prototypes such as `Object.prototype`, `Number.prototype`, and `String.prototype`.\n\nThe issue permits deletion of prototype properties but does not allow overwriting their original behavior.\n\n### Patches\n\nThis issue is patched in 4.18.0.\n\n### Workarounds\n\nNone. Upgrade to the patched version.","type":"reviewed","severity":"medium","repository_advisory_url":"https://api.github.com/repos/lodash/lodash/security-advisories/GHSA-f23m-r3pf-42rh","source_code_location":"https://github.com/lodash/lodash","identifiers":[{"value":"GHSA-f23m-r3pf-42rh","type":"GHSA"},{"value":"CVE-2026-2950","type":"CVE"}],"references":["https://github.com/lodash/lodash/security/advisories/GHSA-f23m-r3pf-42rh","https://github.com/lodash/lodash/security/advisories/GHSA-xxjr-mmjv-4gpg","https://nvd.nist.gov/vuln/detail/CVE-2026-2950","https://github.com/advisories/GHSA-f23m-r3pf-42rh"],"published_at":"2026-04-01T23:50:27Z","updated_at":"2026-04-01T23:50:28Z","github_reviewed_at":"2026-04-01T23:50:27Z","nvd_published_at":"2026-03-31T20:16:26Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"npm","name":"lodash"},"vulnerable_version_range":"<= 4.17.23","first_patched_version":"4.18.0","vulnerable_functions":[]},{"package":{"ecosystem":"npm","name":"lodash-es"},"vulnerable_version_range":"<= 4.17.23","first_patched_version":"4.18.0","vulnerable_functions":[]},{"package":{"ecosystem":"npm","name":"lodash-amd"},"vulnerable_version_range":"<= 4.17.23","first_patched_version":"4.18.0","vulnerable_functions":[]},{"package":{"ecosystem":"npm","name":"lodash.unset"},"vulnerable_version_range":">= 4.0.0, < 4.18.0","first_patched_version":"4.18.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:L","score":6.5},"cvss_v4":{"vector_string":null,"score":0.0}},"cwes":[{"cwe_id":"CWE-1321","name":"Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution')"}],"cre